# PostgreSQL local. Troque todas as credenciais fora do desenvolvimento.
APP_NAME=Minha Comunidade
POSTGRES_DB=igreja
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local-change-me
POSTGRES_PORT=5434
APP_RUNTIME_PASSWORD=runtime-local-change-me
APP_MIGRATOR_PASSWORD=migrator-local-change-me

# A API usa somente o papel runtime; seeds/migrations usam a URL separada.
DATABASE_URL=postgresql://igreja_runtime:runtime-local-change-me@localhost:5434/igreja
DATABASE_MIGRATION_URL=postgresql://igreja_migrator:migrator-local-change-me@localhost:5434/igreja
DATABASE_ADMIN_URL=postgresql://postgres:postgres-local-change-me@localhost:5434/igreja

API_PORT=3101
CORS_ORIGIN=http://localhost:3100
JWT_SECRET=local-only-replace-with-at-least-32-random-characters
JWT_ISSUER=igreja-api
JWT_AUDIENCE=igreja-web
# Use um segredo diferente de JWT_SECRET em produção.
SESSION_BINDING_SECRET=local-session-binding-replace-with-32-characters

# Redes do proxy imediatamente à frente da API. Não use `true`.
# Em Docker/Traefik, redes privadas são esperadas; restrinja na implantação quando possível.
TRUST_PROXY=loopback,linklocal,uniquelocal

# Desenvolvimento: arquivos locais. Em produção, registre um adapter de object storage.
MEDIA_STORAGE_PATH=../../.data/media

NUXT_PUBLIC_API_BASE_URL=http://localhost:3101/api
