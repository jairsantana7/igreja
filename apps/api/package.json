    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jose": "6.2.11",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "2.2.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
